# Local SQLite database. Defaults to ./data/vipcheap.db.
DATABASE_PATH=./data/vipcheap.db

# Initial administrator created only when the database has no matching admin.
ADMIN_EMAIL=admin@vipcheap.local
ADMIN_PASSWORD=change-this-before-deployment

# Payment mode: sandbox (default) or stripe.
PAYMENTS_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local HTTP only. Remove in HTTPS production deployments.
ALLOW_INSECURE_COOKIE=1
